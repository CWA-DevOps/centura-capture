# Centura Capture — local secrets (copy to .env and fill in). .env is gitignored.

# Deepgram streaming STT (M2). Get a key at https://console.deepgram.com/.
# If this is empty/absent, transcription falls back to the local engine (Parakeet).
DEEPGRAM_API_KEY=

# CenturaOS vault Meetings/ folder (M3). On meeting end, the transcript is written to
# <root>/Inbox/ and the paired note to <root>/Meeting Notes/. Defaults to
# C:\Users\JakeSteffens\Claude\CenturaOS\Meetings if unset.
CENTURA_VAULT_ROOT=

# Keyterm prompting (nova-3, free): bias transcription toward firm vocabulary.
# Comma-separated, <=500 tokens total (~20-50 terms is the sweet spot).
# Edit this list anytime, then restart the app to reload.
DEEPGRAM_KEYTERMS=Centura Wealth Advisory,Centura,Jake Steffens
